{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitPulse",
  "version": "1.0.0",
  "identifier": "com.gitpulse.app",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "GitPulse",
        "label": "main",
        "width": 380,
        "height": 570,
        "minWidth": 340,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": true,
        "windowEffects": {
          "effects": [
            "hudWindow",
            "underWindowBackground"
          ],
          "state": "active",
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}

